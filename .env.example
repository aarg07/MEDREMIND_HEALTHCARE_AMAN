# Root project environment example
# Create per-service .env files under backend/ and frontend/ as needed.

# Backend server
BACKEND_PORT=5000
BACKEND_MONGODB_URI=mongodb://localhost:27017/medremind
BACKEND_JWT_SECRET=replace_with_secure_secret
BACKEND_RESEND_API_KEY=replace_with_api_key_if_used
BACKEND_CLIENT_URL=http://localhost:5173
BACKEND_COOKIE_NAME=medremind_token
BACKEND_COOKIE_DOMAIN=

# Frontend client
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=replace_with_google_client_id
